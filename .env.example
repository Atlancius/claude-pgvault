# Copier en .env (jamais versionné) ou exporter dans le profil shell.
# Commande psql qui lit le SQL sur l'entrée standard.
PGVAULT_PSQL='psql "postgresql://utilisateur@hote:5432/base"'
# Fichier de la clé maître, droits 600.
PGVAULT_KEY_FILE=~/.config/pgvault/vault.key
# Ou : commande qui imprime la clé (gestionnaire de mots de passe).
# PGVAULT_KEY_CMD='op read op://Coffre/pgvault/cle'
# PGVAULT_SCHEMA=vault
# PGVAULT_TABLE=secrets
