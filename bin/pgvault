#!/bin/sh
# pgvault : lance scripts/pgvault.py avec le premier Python 3.8+ trouvé.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for p in python3 python py; do
  if command -v "$p" >/dev/null 2>&1 && "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    exec "$p" "$DIR/../scripts/pgvault.py" "$@"
  fi
done
echo "pgvault : Python 3.8+ introuvable" >&2
exit 127
